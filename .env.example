# Copy to .env and fill in values locally. Do not commit .env.

# Ingestion (dlt)
# Destination: "duckdb" locally, "motherduck" for cloud runs.
PIPELINE_DESTINATION="duckdb"
SOURCES__TMDB__API_KEY=""
SOURCES__OMDB__API_KEY=""
SOURCES__ANTHROPIC__API_KEY=""

# MotherDuck
DESTINATION__MOTHERDUCK__CREDENTIALS="md:///horror_movies?motherduck_token="
MOTHERDUCK_PROD_TOKEN=""

# dbt
DBT_TARGET="dev-local"

# Dagster
DAGSTER_ENVIRONMENT="dev"
DAGSTER_POSTGRESQL_HOST="dagster-postgresql"
DAGSTER_POSTGRESQL_PORT="5432"
DAGSTER_POSTGRESQL_USERNAME="dagster"
DAGSTER_POSTGRESQL_PASSWORD=""
DAGSTER_POSTGRESQL_DATABASE="dagster"

# For dbt MCP assistance
HM_ANALYTICS_DBT_PROJECT_DIR=""
HM_ANALYTICS_DBT_PAT=""
